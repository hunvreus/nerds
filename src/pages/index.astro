---
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

const title = "NERDS - A community for curious, ambitious nerds in Singapore";
const description = "A Singapore community for curious, ambitious nerds—founders, technologists, researchers, builders, open-source contributors, and people obsessed with their craft.";
const canonical = "https://nerds.sg/";
const socialImage = `${canonical}og-card.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Ronan Berder" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#151516" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NERDS" />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NERDS — a community for curious, ambitious nerds in Singapore" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="NERDS — a community for curious, ambitious nerds in Singapore" />
    <meta name="twitter:creator" content="@hunvreus" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <pre class="logo" aria-label="NERDS">░░░ NERDS ░░░</pre>

      <section>
        <h1><span>#</span> ABOUT</h1>
        <p>A community for curious, ambitious nerds in Singapore: founders, entrepreneurs, technologists, researchers, builders, open-source contributors, and anyone deeply obsessed with their craft.</p>
        <p>Come to exchange ideas, share what you’re building, and meet people who love going down the rabbit hole.</p>
      </section>

      <section>
        <h1><span>#</span> JOIN US</h1>
        <p>Tell us a little about yourself. We’ll use this to invite people to upcoming NERDS gatherings.</p>

        <form id="join-form" action="/api/join" method="post">
          <div class="fields">
            <div class="field"><label for="name">FULL NAME <span>(REQUIRED)</span></label><input id="name" name="name" type="text" autocomplete="name" required /></div>
            <div class="field"><label for="email">EMAIL <span>(REQUIRED)</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="social">SOCIAL</label><textarea id="social" name="social" rows="1" placeholder="X, LinkedIn, personal site, etc."></textarea></div>
            <div class="field"><label for="background">BACKGROUND <span>(REQUIRED)</span></label><textarea id="background" name="background" rows="1" placeholder="Who you are, what you’ve done..." required></textarea></div>
            <div class="field"><label for="interests">INTERESTS <span>(REQUIRED)</span></label><textarea id="interests" name="interests" rows="1" placeholder="What can you talk about for an unreasonable amount of time?" required></textarea></div>
          </div>

          <button type="submit">SUBMIT</button>
          <small class="status" aria-live="polite"></small>
        </form>
      </section>

      <section>
        <h1><span>#</span> CONTACT</h1>
        <ul>
          <li>X: <a href="https://x.com/hunvreus" target="_blank" rel="noopener noreferrer">@hunvreus</a></li>
          <li>Email: <a href="mailto:hey@ronanberder.com">hey@ronanberder.com</a></li>
        </ul>
      </section>

      <footer>
        <span>© 2026 <a href="https://ronanberder.com" target="_blank" rel="noopener noreferrer">RONAN BERDER</a></span>
      </footer>
    </main>

    <script>
      const form = document.querySelector("#join-form");
      const status = document.querySelector(".status");

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

        const button = form.querySelector("button");
        if (!(button instanceof HTMLButtonElement)) return;
        const data = new FormData(form);
        const controls = form.querySelectorAll("input, textarea, button");

        controls.forEach((control) => {
          if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLButtonElement) control.disabled = true;
        });
        button.setAttribute("aria-busy", "true");
        button.textContent = "SUBMITTING...";
        status.textContent = "";

        try {
          await Promise.all([
            fetch(form.action, { method: "POST", body: data }).then(async (response) => {
              if (response.ok) return;
              const result = await response.json().catch(() => null);
              const message = result && typeof result === "object" && "error" in result && typeof result.error === "string"
                ? result.error
                : "Could not submit the form";
              throw new Error(message);
            }),
            new Promise((resolve) => window.setTimeout(resolve, 900)),
          ]);
          form.reset();
          status.textContent = "THANK YOU. YOU'RE ON THE LIST.";
        } catch (error) {
          status.textContent = error instanceof Error ? `${error.message.toUpperCase()}.` : "FAILED TO SEND. TRY AGAIN.";
        } finally {
          button.textContent = "SUBMIT";
          button.removeAttribute("aria-busy");
          controls.forEach((control) => {
            if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLButtonElement) control.disabled = false;
          });
        }
      });
    </script>
  </body>
</html>
